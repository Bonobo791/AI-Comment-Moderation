# Local/preview builds are noindex by default. No credentials are needed.
SITE_URL=https://aicommentmoderation.com
# Set true only when preparing an explicitly authorized public release artifact.
SITE_RELEASE=false
# Optional public source SHA for previews; release artifacts require exact source identity.
# SITE_COMMIT=<40-character lowercase Git commit SHA>
# Coolify uses the values above as build variables, not runtime configuration.
# Container port is fixed at 8080. No secret, database, storage or model variable is needed.
